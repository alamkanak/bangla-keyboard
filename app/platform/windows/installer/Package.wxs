<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
    <Package
        Name="Bangla Keyboard"
        Manufacturer="Bangla Keyboard Project"
        Version="0.1.0"
        UpgradeCode="E7A1B2C3-D4E5-6789-ABCD-EF0123456789"
        Language="1033"
        Codepage="1252">

        <MajorUpgrade
            DowngradeErrorMessage="A newer version of Bangla Keyboard is already installed." />

        <MediaTemplate EmbedCab="yes" />

        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="Bangla Keyboard">
                <Directory Id="DataFolder" Name="data">
                    <Directory Id="AutocorrectFolder" Name="autocorrect" />
                    <Directory Id="DictionaryFolder" Name="dictionary" />
                    <Directory Id="LayoutsFolder" Name="layouts" />
                </Directory>
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ShortcutFolder" Name="Bangla Keyboard" />
        </StandardDirectory>

        <StandardDirectory Id="AppDataFolder">
            <Directory Id="SettingsAppDataFolder" Name="dev.banglakeyboard.settings" />
        </StandardDirectory>

        <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
            <Component Id="MainDLL" Bitness="always64">
                <File Id="BanglaKeyboardDLL" Source="$(var.DllDir)\BanglaKeyboard.dll"
                    KeyPath="yes" SelfRegCost="1" />
            </Component>
            <Component Id="SettingsApp" Bitness="always64">
                <File Id="SettingsExe" Source="$(var.SettingsDir)\tauri-settings.exe" Name="BanglaKeyboardSettings.exe" />
            </Component>
        </ComponentGroup>

        <ComponentGroup Id="StartMenuShortcuts" Directory="ShortcutFolder">
            <Component Id="SettingsShortcut" Guid="B7A3E1F2-4C5D-4E9A-8B12-6F7D9A2C1E45">
                <Shortcut Id="SettingsStartMenuShortcut"
                    Name="Bangla Keyboard Settings"
                    Description="Configure Bangla Keyboard layouts, theme, and language"
                    Target="[INSTALLFOLDER]BanglaKeyboardSettings.exe"
                    WorkingDirectory="INSTALLFOLDER" />
                <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
                <RegistryValue Root="HKCU"
                    Key="Software\Bangla Keyboard\Installed"
                    Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <!-- On uninstall, sweep the Tauri Settings app's per-user config folder
             (%APPDATA%\dev.banglakeyboard.settings, holding preferences.json).
             util:RemoveFolderEx walks recursively so any future subfolders
             Tauri may create also go away. -->
        <ComponentGroup Id="AppDataCleanup" Directory="SettingsAppDataFolder">
            <Component Id="RemoveSettingsAppData" Guid="C8D5A6B3-7F92-4A1C-BE47-2D8F1C5E90A3">
                <RegistryValue Root="HKCU"
                    Key="Software\Bangla Keyboard\Installed"
                    Name="AppDataCleanup" Type="integer" Value="1" KeyPath="yes" />
                <util:RemoveFolderEx On="uninstall" Property="SETTINGSAPPDATAPATH" />
            </Component>
        </ComponentGroup>

        <SetProperty Id="SETTINGSAPPDATAPATH"
            Value="[AppDataFolder]dev.banglakeyboard.settings"
            After="CostFinalize"
            Sequence="execute" />

        <ComponentGroup Id="DataFiles" Directory="DataFolder">
            <Component Id="AvroPhonetic" Bitness="always64">
                <File Id="avrophonetic_json" Source="$(var.DataDir)\avrophonetic.json" KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <ComponentGroup Id="AutocorrectFiles" Directory="AutocorrectFolder">
            <Component Id="AutocorrectData" Bitness="always64">
                <File Id="autocorrect_json" Source="$(var.DataDir)\autocorrect\autocorrect.json"
                    KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <ComponentGroup Id="DictionaryFiles" Directory="DictionaryFolder">
            <Component Id="DictionaryData" Bitness="always64">
                <File Id="dictionary_json" Source="$(var.DataDir)\dictionary\dictionary.json"
                    KeyPath="yes" />
            </Component>
            <Component Id="DictionaryRegex" Bitness="always64">
                <File Id="regex_json" Source="$(var.DataDir)\dictionary\regex.json" KeyPath="yes" />
            </Component>
            <Component Id="DictionarySuffix" Bitness="always64">
                <File Id="suffix_json" Source="$(var.DataDir)\dictionary\suffix.json" KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <ComponentGroup Id="LayoutFiles" Directory="LayoutsFolder">
            <Component Id="LayoutNational" Bitness="always64">
                <File Id="national_json" Source="$(var.DataDir)\layouts\national.json" KeyPath="yes" />
            </Component>
            <Component Id="LayoutPhonetic" Bitness="always64">
                <File Id="phonetic_json" Source="$(var.DataDir)\layouts\phonetic.json" KeyPath="yes" />
            </Component>
            <Component Id="LayoutUniBijoy" Bitness="always64">
                <File Id="unibijoy_json" Source="$(var.DataDir)\layouts\unibijoy.json" KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <Feature Id="ProductFeature" Title="Bangla Keyboard" Level="1">
            <ComponentGroupRef Id="ProductComponents" />
            <ComponentGroupRef Id="StartMenuShortcuts" />
            <ComponentGroupRef Id="AppDataCleanup" />
            <ComponentGroupRef Id="DataFiles" />
            <ComponentGroupRef Id="AutocorrectFiles" />
            <ComponentGroupRef Id="DictionaryFiles" />
            <ComponentGroupRef Id="LayoutFiles" />
        </Feature>

        <!-- SelfRegCost="1" on the TSF DLL <File> already schedules DllRegisterServer /
             DllUnregisterServer via the built-in SelfRegModules / SelfUnregModules
             standard actions, so no explicit CustomAction is required. -->

        <!-- On a fresh install (not upgrades / repairs / uninstalls) launch the
             Settings app so the onboarding wizard pops up. Runs unelevated as
             the invoking user. -->
        <CustomAction Id="LaunchSettingsApp"
            FileRef="SettingsExe"
            ExeCommand=""
            Impersonate="yes"
            Return="asyncNoWait" />
        <InstallExecuteSequence>
            <Custom Action="LaunchSettingsApp" After="InstallFinalize"
                Condition="NOT Installed AND NOT REMOVE" />
        </InstallExecuteSequence>

    </Package>
</Wix>