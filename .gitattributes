# Default: let Git handle text detection, normalize to LF in the repo.
* text=auto eol=lf

# Generated by cbindgen (app/crates/engine-ffi/build.rs) on every build.
# Pin to LF so Windows checkouts don't produce spurious "modified" churn.
app/crates/engine-ffi/bangla_keyboard_engine.h text eol=lf

# Windows-native sources: keep CRLF so MSBuild/VS tooling stays happy.
*.sln  text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf

# Shell scripts must stay LF even on Windows.
*.sh text eol=lf

# Binary formats — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.pdf binary
*.pkg binary
*.msi binary
*.dll binary
*.exe binary
*.lib binary
*.dylib binary
